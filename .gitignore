# ============================================================
#  Arduino / 嵌入式项目 通用 .gitignore
# ============================================================

# ------------------------------------------------------------
# 编译产物
# ------------------------------------------------------------
# 注意：libraries/LiquidCrystal_I2C/LiquidCrystal_I2C.o 是早期手动编译残留的
# 二进制产物，不应纳入版本控制。（如需保留请手动 git add -f）
*.o
*.a
*.d
*.elf
*.bin
*.hex
*.eep
*.lss
*.map
*.sym

# Arduino 构建缓存
build/
build-*/
.arduino15/
.arduino/
*.arduino.bak

# Arduino IDE 1.8.x 生成的 sketch 备份
*.ino.bak
*.pde.bak
*~

# ------------------------------------------------------------
# 编辑器 / IDE
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
platformio.ini.user

# ------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------
# 其它
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo

# 凭证 / 本地配置（切勿提交 token、密码）
*.token
.env
secrets.h
